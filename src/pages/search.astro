---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { products, looks } from '../lib/data';
const searchData = { products, looks };
---
<Base title="Search — MalikFits" description="Search the MalikFits catalog and looks.">
  <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Search' }]} />

  <div class="page-max page-pad mt-6 mb-8">
    <h1 class="font-serif text-[32px] sm:text-[40px] text-ink leading-tight">Search</h1>
    <form id="search-form" class="mt-6 relative" role="search">
      <label for="search-input" class="sr-only">Search products and looks</label>
      <input
        id="search-input"
        name="q"
        type="search"
        class="input pr-12"
        placeholder="Try 'cream', 'jacket', 'streetwear'…"
        autocomplete="off"
        autofocus
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 text-ink-muted" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.25"/>
          <path d="m18 18-4.5-4.5" stroke="currentColor" stroke-width="1.25"/>
        </svg>
      </span>
    </form>
  </div>

  <section class="page-max page-pad">
    <div id="empty" class="text-ink-muted text-sm">
      Try <button type="button" class="underline decoration-hairline underline-offset-4 hover:decoration-accent" data-suggest="cream">cream</button>,
      <button type="button" class="underline decoration-hairline underline-offset-4 hover:decoration-accent" data-suggest="jacket">jacket</button>,
      <button type="button" class="underline decoration-hairline underline-offset-4 hover:decoration-accent" data-suggest="streetwear">streetwear</button>…
    </div>

    <div id="results" hidden>
      <div class="mb-10">
        <p class="label mb-3">Products <span id="p-count">(0)</span></p>
        <div id="product-results" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5"></div>
        <p id="no-products" class="hidden text-ink-muted text-sm">No products match.</p>
      </div>
      <hr />
      <div class="mt-10">
        <p class="label mb-3">Looks <span id="l-count">(0)</span></p>
        <div id="look-results" class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5"></div>
        <p id="no-looks" class="hidden text-ink-muted text-sm">No looks match.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchData)} />
</Base>

<script>
  const data = JSON.parse(document.getElementById('search-data')!.textContent || '{}') as {
    products: Array<{ id: string; name: string; category: string; image: string; price: number; retailer: string; isNew?: boolean }>,
    looks: Array<{ id: string; title: string; style: string; heroImage: string }>,
  };

  const fmt = (n: number) => '$' + n.toLocaleString('en-US');

  const productCard = (p: typeof data.products[number]) => `
    <article>
      <a href="/product/${p.id}" class="block">
        <div class="card-img"><img src="${p.image}" alt="${p.name}" loading="lazy" width="800" height="1000" />
          ${p.isNew ? '<span class="badge-new">New in</span>' : ''}
        </div>
        <div class="mt-3 flex items-baseline justify-between gap-3">
          <h3 class="font-sans font-medium text-[15px] text-ink truncate">${p.name}</h3>
          <p class="text-sm text-ink tabular-nums shrink-0">${fmt(p.price)}</p>
        </div>
        <p class="mt-1 label">Shop at ${p.retailer} →</p>
      </a>
    </article>`;

  const lookCard = (l: typeof data.looks[number]) => `
    <article>
      <a href="/outfits/${l.id}" class="block">
        <div class="relative block w-full aspect-[3/4] overflow-hidden bg-surface border border-hairline">
          <img src="${l.heroImage}" alt="${l.title}" loading="lazy" width="900" height="1200" class="w-full h-full object-cover" />
        </div>
        <div class="mt-3">
          <h3 class="font-serif text-[18px] text-ink leading-tight">${l.title}</h3>
          <p class="mt-1 label">${l.style.replace('-', ' ')}</p>
        </div>
      </a>
    </article>`;

  const input    = document.getElementById('search-input') as HTMLInputElement;
  const results  = document.getElementById('results') as HTMLElement;
  const empty    = document.getElementById('empty') as HTMLElement;
  const pGrid    = document.getElementById('product-results')!;
  const lGrid    = document.getElementById('look-results')!;
  const pCount   = document.getElementById('p-count')!;
  const lCount   = document.getElementById('l-count')!;
  const noP      = document.getElementById('no-products')!;
  const noL      = document.getElementById('no-looks')!;

  const run = (q: string) => {
    q = q.trim().toLowerCase();
    if (!q) { results.hidden = true; empty.hidden = false; return; }
    const matchesP = data.products.filter(p =>
      p.name.toLowerCase().includes(q) ||
      p.category.toLowerCase().includes(q) ||
      p.retailer.toLowerCase().includes(q)
    );
    const matchesL = data.looks.filter(l =>
      l.title.toLowerCase().includes(q) ||
      l.style.toLowerCase().includes(q)
    );
    pGrid.innerHTML = matchesP.map(productCard).join('');
    lGrid.innerHTML = matchesL.map(lookCard).join('');
    pCount.textContent = `(${matchesP.length})`;
    lCount.textContent = `(${matchesL.length})`;
    noP.classList.toggle('hidden', matchesP.length > 0);
    noL.classList.toggle('hidden', matchesL.length > 0);
    results.hidden = false;
    empty.hidden  = true;
  };

  input.addEventListener('input', () => run(input.value));
  document.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach(b => {
    b.addEventListener('click', () => { input.value = b.dataset.suggest!; input.focus(); run(input.value); });
  });

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; run(initial); }
  document.getElementById('search-form')!.addEventListener('submit', e => e.preventDefault());
</script>
