---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { products, looks } from '../lib/data';

const data = { products, looks };
---
<Base title="Wishlist — MalikFits" description="Your saved pieces and looks.">
  <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Wishlist' }]} />

  <div class="page-max page-pad mt-6 mb-8">
    <h1 class="font-serif text-[32px] sm:text-[40px] text-ink leading-tight">Wishlist</h1>
    <p class="mt-3 text-ink-muted">Saved on this device. Clear with the heart icon on each item.</p>
  </div>

  <section class="page-max page-pad">
    <div id="wishlist-empty" class="text-ink-muted text-sm">
      Nothing saved yet. Tap the heart on any product or look to add it here.
      <div class="mt-6 flex gap-3">
        <a href="/catalog" class="btn-secondary">Browse catalog</a>
        <a href="/outfits" class="btn-secondary">Browse looks</a>
      </div>
    </div>

    <div id="wishlist-content" hidden>
      <div class="mb-10">
        <p class="label mb-3">Pieces</p>
        <div id="wp-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5"></div>
        <p id="wp-empty" class="hidden text-ink-muted text-sm">No saved products.</p>
      </div>
      <hr />
      <div class="mt-10">
        <p class="label mb-3">Looks</p>
        <div id="wl-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5"></div>
        <p id="wl-empty" class="hidden text-ink-muted text-sm">No saved looks.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="wishlist-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  const KEY = 'malikfits.wishlist.v1';
  const data = JSON.parse(document.getElementById('wishlist-data')!.textContent || '{}') as {
    products: Array<{ id: string; name: string; image: string; price: number; retailer: string; isNew?: boolean }>,
    looks: Array<{ id: string; title: string; style: string; heroImage: string }>,
  };
  const fmt = (n: number) => '$' + n.toLocaleString('en-US');
  const ids: string[] = JSON.parse(localStorage.getItem(KEY) || '[]');
  const savedP = data.products.filter(p => ids.includes(p.id));
  const savedL = data.looks.filter(l => ids.includes(l.id));

  const empty   = document.getElementById('wishlist-empty')!;
  const content = document.getElementById('wishlist-content') as HTMLElement;

  const total = savedP.length + savedL.length;
  empty.hidden   = total > 0;
  content.hidden = total === 0;

  if (total > 0) {

  const pCard = (p: typeof data.products[number]) => `
    <article>
      <a href="/product/${p.id}" class="block">
        <div class="card-img"><img src="${p.image}" alt="${p.name}" loading="lazy" width="800" height="1000" />
          ${p.isNew ? '<span class="badge-new">New in</span>' : ''}
          <button type="button" class="heart-chip" data-wishlist-id="${p.id}" aria-pressed="true" data-saved="true" aria-label="Remove ${p.name}">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z"/>
            </svg>
          </button>
        </div>
        <div class="mt-3 flex items-baseline justify-between gap-3">
          <h3 class="font-sans font-medium text-[15px] text-ink truncate">${p.name}</h3>
          <p class="text-sm text-ink tabular-nums shrink-0">${fmt(p.price)}</p>
        </div>
        <p class="mt-1 label">Shop at ${p.retailer} →</p>
      </a>
    </article>`;

  const lCard = (l: typeof data.looks[number]) => `
    <article>
      <a href="/outfits/${l.id}" class="block">
        <div class="relative block w-full aspect-[3/4] overflow-hidden bg-surface border border-hairline">
          <img src="${l.heroImage}" alt="${l.title}" loading="lazy" width="900" height="1200" class="w-full h-full object-cover" />
          <button type="button" class="heart-chip" data-wishlist-id="${l.id}" aria-pressed="true" data-saved="true" aria-label="Remove ${l.title}">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z"/>
            </svg>
          </button>
        </div>
        <div class="mt-3">
          <h3 class="font-serif text-[18px] text-ink leading-tight">${l.title}</h3>
          <p class="mt-1 label">${l.style.replace('-', ' ')}</p>
        </div>
      </a>
    </article>`;

    document.getElementById('wp-grid')!.innerHTML = savedP.map(pCard).join('');
    document.getElementById('wl-grid')!.innerHTML = savedL.map(lCard).join('');
    document.getElementById('wp-empty')!.classList.toggle('hidden', savedP.length > 0);
    document.getElementById('wl-empty')!.classList.toggle('hidden', savedL.length > 0);
  }
</script>
