---
import Base from '../layouts/Base.astro';
import CouponCard from '../components/CouponCard.astro';
import { activeCoupons } from '../lib/data';

const list = activeCoupons();
---
<Base
  title="Discounts — MalikFits"
  description="Brands currently on sale, picked by Malik. Tap through for the discount — no comparison sites, direct to retailer."
>
  <section class="page-max page-pad pt-10 sm:pt-16 pb-12">
    <p class="label">Discounts · live now</p>
    <h1 class="mt-5 font-serif font-light text-[44px] sm:text-[72px] leading-[0.96] text-ink tracking-[-0.02em]">
      Brands<br/>on sale.
    </h1>
    <p class="mt-6 max-w-xl text-ink-muted text-[16px] sm:text-[17px] leading-[1.6]">
      Live discounts at the labels Malik wears — tap any card to claim the offer at the retailer. No codes, no checkout games. Just the deal.
    </p>
  </section>

  {list.length === 0 ? (
    <section class="page-max page-pad pb-32">
      <div class="rounded-3xl bg-surface border border-hairline p-10 sm:p-16 text-center">
        <p class="label mb-4">No active discounts</p>
        <p class="font-serif text-[22px] sm:text-[28px] text-ink leading-snug max-w-xl mx-auto">
          New deals coming soon. Save a look in the meantime.
        </p>
        <a href="/outfits" class="btn-secondary mt-8">Browse looks</a>
      </div>
    </section>
  ) : (
    <section class="page-max page-pad pb-24 sm:pb-32">
      <div class="grid gap-4 sm:gap-5">
        {list.map(c => <CouponCard coupon={c} />)}
      </div>
    </section>
  )}
</Base>
