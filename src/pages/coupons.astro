---
import Base from '../layouts/Base.astro';
import CouponCard from '../components/CouponCard.astro';
import { activeCoupons } from '../lib/data';

const list = activeCoupons();
const byRetailer = list.reduce<Record<string, typeof list>>((acc, c) => {
  (acc[c.retailer] ??= []).push(c);
  return acc;
}, {});
const retailers = Object.keys(byRetailer).sort();
---
<Base
  title="Coupons & codes — MalikFits"
  description="Active discount codes hand-picked by Malik for the brands and retailers in the catalog."
>
  <section class="page-max page-pad pt-10 sm:pt-16 pb-12">
    <p class="label">Deals · curated</p>
    <h1 class="mt-4 font-serif text-[40px] sm:text-[64px] leading-[0.98] text-ink tracking-[-0.01em]">
      Codes that<br/>
      <span class="text-ink-muted">actually work.</span>
    </h1>
    <p class="mt-5 max-w-xl text-ink-muted text-[15px] sm:text-[16px] leading-relaxed">
      Verified discounts at the brands Malik curates. Tap copy, then shop — link opens the retailer with the code ready to apply.
    </p>
  </section>

  {list.length === 0 ? (
    <section class="page-max page-pad pb-32">
      <div class="rounded-3xl bg-surface border border-hairline p-10 sm:p-16 text-center">
        <p class="label mb-4">No active codes</p>
        <p class="font-serif text-[22px] sm:text-[28px] text-ink leading-snug max-w-xl mx-auto">
          New drops coming soon. Save a look in the meantime.
        </p>
        <a href="/outfits" class="btn-secondary mt-8">Browse looks</a>
      </div>
    </section>
  ) : (
    <section class="page-max page-pad pb-24 sm:pb-32 space-y-12 sm:space-y-16">
      {retailers.map(retailer => (
        <div>
          <div class="flex items-end justify-between gap-4 mb-6">
            <h2 class="font-serif text-[26px] sm:text-[32px] text-ink leading-tight tracking-[-0.01em]">{retailer}</h2>
            <p class="label">{byRetailer[retailer].length} {byRetailer[retailer].length === 1 ? 'code' : 'codes'}</p>
          </div>
          <div class="grid gap-4 sm:gap-5">
            {byRetailer[retailer].map(c => <CouponCard coupon={c} />)}
          </div>
        </div>
      ))}
    </section>
  )}

</Base>
