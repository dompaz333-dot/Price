---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LookCard from '../../components/LookCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import {
  looks, productById, styleBySlug, similarLooks, formatPrice
} from '../../lib/data';

export function getStaticPaths() {
  return looks.map(l => ({ params: { id: l.id } }));
}

const { id } = Astro.params;
const look = looks.find(l => l.id === id);
if (!look) throw new Error(`Unknown look: ${id}`);

const style   = styleBySlug(look.style)!;
const pieces  = look.productIds.map(pid => productById(pid)!).filter(Boolean);
const similar = similarLooks(look, 6);
---
<Base
  title={`${look.title} — MalikFits`}
  description={look.description ?? `Shop every piece in the "${look.title}" look.`}
  ogImage={look.heroImage}
>
  <Breadcrumb items={[
    { href: '/', label: 'Home' },
    { href: '/outfits', label: 'Looks' },
    { label: look.title }
  ]} />

  <section class="mt-6">
    <div class="relative w-full aspect-[3/4] sm:aspect-[16/10] max-h-[85vh] overflow-hidden bg-surface">
      <img src={look.heroImage} alt={look.title} width="1200" height="1500" fetchpriority="high"
           class="w-full h-full object-cover" />
    </div>

    <div class="page-max page-pad mt-6 flex items-start justify-between gap-4">
      <div>
        <p class="label mb-2">{style.label}</p>
        <h1 class="font-serif text-[32px] sm:text-[44px] text-ink leading-tight">{look.title}</h1>
        {look.description && (
          <p class="mt-3 font-serif italic text-ink-muted text-[18px] max-w-xl">{look.description}</p>
        )}
      </div>
      <button
        type="button"
        class="heart-chip !static !w-10 !h-10 shrink-0"
        data-wishlist-id={look.id}
        aria-pressed="false"
        aria-label={`Save ${look.title} to wishlist`}
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z"
            stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0"/>
        </svg>
      </button>
    </div>
  </section>

  <section class="page-max page-pad section-y">
    <div class="mb-8">
      <p class="label mb-2">Get the look</p>
      <h2 class="font-serif text-[24px] sm:text-[28px] text-ink">The pieces in this fit.</h2>
    </div>

    <ul class="divide-y divide-hairline border-y border-hairline">
      {pieces.map(p => (
        <li class="py-4 sm:py-5 grid grid-cols-[88px_1fr_auto] sm:grid-cols-[112px_1fr_auto] gap-4 items-center">
          <a href={`/product/${p.id}`} class="block bg-surface border border-hairline aspect-square overflow-hidden">
            <img src={p.image} alt={p.name} width="220" height="220" loading="lazy"
                 class="w-full h-full object-cover" />
          </a>
          <div class="min-w-0">
            <a href={`/product/${p.id}`} class="block">
              <p class="label mb-1">{p.category.replace('-', ' ')}</p>
              <h3 class="font-sans font-medium text-[15px] sm:text-[16px] text-ink truncate">{p.name}</h3>
              <p class="mt-1 text-sm text-ink tabular-nums">{formatPrice(p.price)} <span class="text-ink-muted">· {p.retailer}</span></p>
            </a>
          </div>
          <a
            href={p.affiliateUrl}
            target="_blank"
            rel="noopener sponsored nofollow"
            class="btn-secondary"
          >
            Shop →
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-4 text-xs text-ink-muted">Affiliate links · each opens in a new tab</p>
  </section>

  {similar.length > 0 && (
    <section class="page-max page-pad section-y">
      <SectionHeader label="Similar looks" title={`More in ${style.label}.`} href="/outfits" hrefLabel="All looks" />
      <div class="scroll-x">
        {similar.map(l => (
          <div class="w-[62%] sm:w-[32%] lg:w-[24%]">
            <LookCard look={l} />
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
