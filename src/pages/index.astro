---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import LookCard from '../components/LookCard.astro';
import CouponCard from '../components/CouponCard.astro';
import { newReleases, looks, categories, activeCoupons } from '../lib/data';

const featuredLooks = looks.slice(0, 4);
const newDrops      = newReleases(10);
const topCoupons    = activeCoupons().slice(0, 2);
const issueNumber   = String(Math.max(1, Math.floor((Date.now() - Date.parse('2026-01-01')) / (7 * 24 * 60 * 60 * 1000)))).padStart(2, '0');
---
<Base>
  {/* HERO — editorial statement */}
  <section class="page-max page-pad pt-14 sm:pt-24 pb-16 sm:pb-24">
    <div class="flex items-center gap-3 text-ink-soft">
      <span class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium">Issue {issueNumber}</span>
      <span aria-hidden="true" class="block w-8 h-px bg-hairline"></span>
      <span class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium">A curated edit by Malik</span>
    </div>
    <h1 class="mt-7 font-serif font-light text-[52px] sm:text-[88px] lg:text-[108px] leading-[0.92] text-ink tracking-[-0.025em]">
      Shop the fit.
    </h1>
    <p class="mt-6 max-w-xl text-ink-muted text-[16px] sm:text-[17px] leading-[1.6]">
      A weekly edit of menswear — curated, not stocked. Every look links straight through to the piece, from the brands worth wearing.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/outfits" class="btn-primary">Browse this week's looks</a>
      <a href="/catalog" class="btn-secondary">The full catalog</a>
    </div>
  </section>

  <div class="page-max page-pad"><hr class="border-t border-hairline" /></div>

  {/* CATEGORY ROW — discreet */}
  <section class="page-max page-pad py-10 sm:py-14">
    <div class="flex gap-6 sm:gap-10 overflow-x-auto -mx-5 px-5 sm:-mx-10 sm:px-10 lg:-mx-20 lg:px-20 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <a href="/catalog" class="cat-circle group">
        <div class="ring flex items-center justify-center">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-ink-muted">
            <rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="13" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="4" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="13" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </div>
        <span class="name">All</span>
      </a>
      {categories.map(c => (
        <a href={`/catalog/${c.slug}`} class="cat-circle group">
          <div class="ring">
            <img src={c.image} alt="" width="96" height="96" loading="lazy" />
          </div>
          <span class="name">{c.label}</span>
        </a>
      ))}
    </div>
  </section>

  <div class="page-max page-pad"><hr class="border-t border-hairline" /></div>

  {/* FEATURED LOOKS — the edit */}
  <section class="page-max page-pad py-16 sm:py-24">
    <header class="flex items-end justify-between gap-6 mb-10 sm:mb-14">
      <div>
        <p class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium text-ink-soft">The edit · {featuredLooks.length} looks</p>
        <h2 class="mt-3 font-serif font-light text-[34px] sm:text-[52px] leading-[1.02] text-ink tracking-[-0.02em]">This week.</h2>
      </div>
      <a href="/outfits" class="btn-text">All looks →</a>
    </header>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-3 gap-y-10 sm:gap-x-5 sm:gap-y-14">
      {featuredLooks.map(l => <LookCard look={l} />)}
    </div>
  </section>

  <div class="page-max page-pad"><hr class="border-t border-hairline" /></div>

  {/* NEW RELEASES */}
  <section class="py-16 sm:py-24">
    <header class="page-max page-pad flex items-end justify-between gap-6 mb-10">
      <div>
        <p class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium text-ink-soft">New in</p>
        <h2 class="mt-3 font-serif font-light text-[34px] sm:text-[52px] leading-[1.02] text-ink tracking-[-0.02em]">Fresh pieces.</h2>
      </div>
      <a href="/catalog" class="btn-text">Show all →</a>
    </header>
    <div class="page-max">
      <div class="scroll-x">
        {newDrops.map(p => <ProductCard product={p} widthClass="w-[62%] sm:w-[32%] lg:w-[22%]" />)}
      </div>
    </div>
  </section>

  {topCoupons.length > 0 && (
    <>
      <div class="page-max page-pad"><hr class="border-t border-hairline" /></div>
      <section class="page-max page-pad py-16 sm:py-24">
        <header class="flex items-end justify-between gap-6 mb-10">
          <div>
            <p class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium text-ink-soft">Editor's notes</p>
            <h2 class="mt-3 font-serif font-light text-[34px] sm:text-[52px] leading-[1.02] text-ink tracking-[-0.02em]">Worth using.</h2>
          </div>
          <a href="/coupons" class="btn-text">All codes →</a>
        </header>
        <div class="grid gap-4 sm:gap-5 sm:grid-cols-2">
          {topCoupons.map(c => <CouponCard coupon={c} compact={true} />)}
        </div>
      </section>
    </>
  )}

  <div class="page-max page-pad"><hr class="border-t border-hairline" /></div>

  {/* EDITORIAL — closing note */}
  <section class="page-max page-pad py-20 sm:py-32">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-sans uppercase tracking-[0.18em] text-[10.5px] font-medium text-ink-soft">A note from Malik</p>
      <p class="mt-6 font-serif font-light text-[26px] sm:text-[36px] leading-[1.2] text-ink tracking-[-0.015em]">
        I don't stock anything. I just wear it, then I tell you where it's from.
      </p>
      <div class="mt-10">
        <a href="/about" class="btn-text">More about the edit →</a>
      </div>
    </div>
  </section>
</Base>
