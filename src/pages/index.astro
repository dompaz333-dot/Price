---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import LookCard from '../components/LookCard.astro';
import CouponCard from '../components/CouponCard.astro';
import { newReleases, looks, categories, activeCoupons } from '../lib/data';

const featuredLooks = looks.slice(0, 4);
const newDrops      = newReleases(10);
const topCoupons    = activeCoupons().slice(0, 2);
---
<Base>
  {/* HERO — big bold serif statement + search */}
  <section class="page-max page-pad pt-10 sm:pt-16 pb-10">
    <p class="label">A curated edit by Malik</p>
    <h1 class="mt-4 font-serif text-[44px] sm:text-[72px] lg:text-[88px] leading-[0.95] text-ink tracking-[-0.01em]">
      Shop the fit.<br/>
      <span class="text-ink-muted">Built for taste.</span>
    </h1>
    <p class="mt-6 max-w-xl text-ink-muted text-[15px] sm:text-[17px] leading-relaxed">
      Curated outfits and pieces — refreshed weekly. Tap any look to shop the exact items.
    </p>

    <form action="/search" method="get" class="mt-8 max-w-xl">
      <label class="flex items-center gap-3 h-14 pl-6 pr-2 rounded-full bg-surface border border-hairline focus-within:border-ink/40 transition-colors">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="shrink-0 text-ink-muted">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.4"/>
          <path d="m18 18-4.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search outfits, brands, pieces…"
          class="flex-1 min-w-0 h-full bg-transparent border-0 outline-none text-[15px] text-ink placeholder:text-ink-soft"
        />
        <button type="submit" class="w-11 h-11 rounded-full bg-ink text-bg inline-flex items-center justify-center transition-opacity hover:opacity-90" aria-label="Search">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </label>
    </form>
  </section>

  {/* CATEGORY CIRCLES */}
  <section class="page-max page-pad pb-12">
    <div class="flex gap-5 sm:gap-8 overflow-x-auto -mx-5 px-5 sm:-mx-10 sm:px-10 lg:-mx-20 lg:px-20 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <a href="/catalog" class="cat-circle group">
        <div class="ring flex items-center justify-center">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-ink-muted">
            <rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="13" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="4" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
            <rect x="13" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </div>
        <span class="name">All</span>
      </a>
      {categories.map(c => (
        <a href={`/catalog/${c.slug}`} class="cat-circle group">
          <div class="ring">
            <img src={c.image} alt="" width="96" height="96" loading="lazy" />
          </div>
          <span class="name">{c.label}</span>
        </a>
      ))}
    </div>
  </section>

  {/* FEATURED LOOKS — the "shop the fit" hero section */}
  <section class="page-max page-pad pb-20 sm:pb-28">
    <div class="flex items-end justify-between gap-4 mb-8 sm:mb-12">
      <div>
        <p class="label mb-3">This week's edit</p>
        <h2 class="font-serif text-[32px] sm:text-[44px] leading-[1.02] text-ink tracking-[-0.01em]">Get the fit.</h2>
      </div>
      <a href="/outfits" class="btn-secondary">All looks</a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {featuredLooks.map(l => <LookCard look={l} />)}
    </div>
  </section>

  {/* NEW RELEASES — horizontal scroll */}
  <section class="pb-20 sm:pb-28">
    <div class="page-max page-pad flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="label mb-3">New releases</p>
        <h2 class="font-serif text-[32px] sm:text-[44px] leading-[1.02] text-ink tracking-[-0.01em]">Fresh drops.</h2>
      </div>
      <a href="/catalog" class="btn-secondary">Show all</a>
    </div>
    <div class="page-max">
      <div class="scroll-x">
        {newDrops.map(p => <ProductCard product={p} widthClass="w-[62%] sm:w-[32%] lg:w-[22%]" />)}
      </div>
    </div>
  </section>

  {/* COUPONS — discovery */}
  {topCoupons.length > 0 && (
    <section class="page-max page-pad pb-20 sm:pb-28">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <p class="label mb-3">Deals · curated</p>
          <h2 class="font-serif text-[32px] sm:text-[44px] leading-[1.02] text-ink tracking-[-0.01em]">Codes worth using.</h2>
        </div>
        <a href="/coupons" class="btn-secondary">All codes</a>
      </div>
      <div class="grid gap-4 sm:gap-5 sm:grid-cols-2">
        {topCoupons.map(c => <CouponCard coupon={c} compact={true} />)}
      </div>
    </section>
  )}

  {/* EDITORIAL — quiet luxury closing */}
  <section class="page-max page-pad pb-24 sm:pb-32">
    <div class="rounded-3xl bg-surface border border-hairline p-10 sm:p-16 text-center">
      <p class="label mb-5">Meet Malik</p>
      <p class="font-serif text-[24px] sm:text-[34px] leading-[1.15] text-ink tracking-[-0.01em] max-w-2xl mx-auto">
        Curated weekly. Built for taste — without the noise.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="/about" class="btn-secondary">Read more</a>
      </div>
    </div>
  </section>
</Base>
