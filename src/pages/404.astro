---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — MalikFits">
  <section class="page-max page-pad pt-20 sm:pt-32 pb-32 text-center">
    <p class="label">404</p>
    <h1 class="mt-6 font-serif font-light text-[44px] sm:text-[72px] leading-[0.95] text-ink tracking-[-0.02em] max-w-2xl mx-auto">
      That fit isn't here.
    </h1>
    <p class="mt-6 max-w-md mx-auto text-ink-muted text-[16px] leading-[1.6]">
      The page you're after was moved, retired, or never existed. Head back to the edit.
    </p>
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn-primary">Back to the edit</a>
      <a href="/catalog" class="btn-secondary">Browse the catalog</a>
    </div>
  </section>
</Base>
