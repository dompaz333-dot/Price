---
interface Crumb { href?: string; label: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props as Props;
---
<nav aria-label="Breadcrumb" class="page-max page-pad pt-6">
  <ol class="flex flex-wrap items-center gap-1 text-xs text-ink-muted">
    {items.map((c, i) => (
      <li class="flex items-center gap-1">
        {c.href ? (
          <a href={c.href} class="hover:text-ink uppercase tracking-label">{c.label}</a>
        ) : (
          <span class="uppercase tracking-label text-ink">{c.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
