---
import type { Product } from '../lib/data';
import { formatPrice } from '../lib/data';

interface Props { product: Product; widthClass?: string; }
const { product, widthClass = 'w-full' } = Astro.props as Props;
---
<article class={`${widthClass} group`}>
  <a href={`/product/${product.id}`} class="block">
    <div class="card-img">
      <img src={product.image} alt={product.name} loading="lazy" width="800" height="1000" />
      {product.isNew && <span class="badge-new">New in</span>}
      <button
        type="button"
        class="heart-chip"
        data-wishlist-id={product.id}
        aria-pressed="false"
        aria-label={`Save ${product.name} to wishlist`}
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z"
            stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0"/>
        </svg>
      </button>
    </div>
    <div class="mt-4">
      <p class="font-sans uppercase tracking-[0.14em] text-[10.5px] text-ink-soft font-medium">{product.retailer}</p>
      <div class="mt-1.5 flex items-baseline justify-between gap-3">
        <h3 class="font-serif text-[16px] sm:text-[17px] text-ink leading-tight tracking-[-0.005em] truncate">{product.name}</h3>
        <p class="text-[13px] text-ink tabular-nums shrink-0">{formatPrice(product.price)}</p>
      </div>
    </div>
  </a>
</article>
