---
import { categories, styles } from '../lib/data';
---
<header class="sticky top-0 z-40 bg-bg/95 backdrop-blur supports-[backdrop-filter]:bg-bg/80 border-b border-hairline">
  <div class="page-max page-pad h-14 grid grid-cols-[auto_1fr_auto] items-center gap-4">
    <button
      type="button"
      id="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-menu"
      class="w-10 h-10 -ml-2 flex items-center justify-center text-ink"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/>
      </svg>
    </button>

    <a href="/" class="font-serif text-[20px] tracking-[0.04em] text-center text-ink leading-none">
      MalikFits
    </a>

    <div class="flex items-center gap-1 -mr-2">
      <a href="/search" aria-label="Search" class="w-10 h-10 flex items-center justify-center text-ink">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.25"/>
          <path d="m18 18-4.5-4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/>
        </svg>
      </a>
      <a href="/wishlist" aria-label="Wishlist" class="relative w-10 h-10 flex items-center justify-center text-ink">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z" stroke="currentColor" stroke-width="1.25"/>
        </svg>
        <span
          data-wishlist-count
          class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 inline-flex items-center justify-center bg-ink text-bg text-[10px] font-medium leading-none"
          style="display:none"
        ></span>
      </a>
    </div>
  </div>

  <nav
    id="site-menu"
    hidden
    aria-label="Main"
    class="border-t border-hairline bg-bg"
  >
    <div class="page-max page-pad py-6 grid gap-6 sm:grid-cols-2">
      <div>
        <p class="label mb-3">Catalog</p>
        <ul class="space-y-2">
          <li><a class="text-ink hover:text-accent" href="/catalog">All Products</a></li>
          {categories.map(c => (
            <li><a class="text-ink hover:text-accent" href={`/catalog/${c.slug}`}>{c.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="label mb-3">Looks</p>
        <ul class="space-y-2">
          <li><a class="text-ink hover:text-accent" href="/outfits">All Looks</a></li>
          {styles.map(s => (
            <li><a class="text-ink hover:text-accent" href={`/outfits?style=${s.slug}`}>{s.label}</a></li>
          ))}
        </ul>
        <p class="label mt-6 mb-3">More</p>
        <ul class="space-y-2">
          <li><a class="text-ink hover:text-accent" href="/about">About Malik</a></li>
          <li><a class="text-ink hover:text-accent" href="/wishlist">Wishlist</a></li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('site-menu')!;
  btn.addEventListener('click', () => {
    const open = nav.hasAttribute('hidden') ? false : true;
    if (open) { nav.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
    else      { nav.removeAttribute('hidden');  btn.setAttribute('aria-expanded', 'true');  }
  });
</script>
