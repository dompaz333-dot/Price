---
import { categories, styles } from '../lib/data';
---
<header class="sticky top-0 z-40 pt-3 sm:pt-4">
  <div class="page-max page-pad">
    <div class="flex items-center gap-2 p-2 rounded-full bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70 border border-hairline shadow-[0_4px_24px_-12px_rgba(22,19,15,0.18)]">
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        class="pill-icon shrink-0"
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>

      <a href="/" aria-label="Home" class="pill-icon shrink-0">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10 10 4l7 6v6a1 1 0 0 1-1 1h-3v-5H7v5H4a1 1 0 0 1-1-1v-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
      </a>

      <form action="/search" method="get" class="flex-1 min-w-0">
        <label class="flex items-center gap-2 h-11 px-4 rounded-full bg-surface border border-hairline text-ink-muted focus-within:border-ink/40 transition-colors">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="shrink-0">
            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.4"/>
            <path d="m18 18-4.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search the catalog"
            class="flex-1 min-w-0 bg-transparent border-0 outline-none text-[14px] text-ink placeholder:text-ink-soft"
          />
        </label>
      </form>

      <a href="/wishlist" aria-label="Wishlist" class="pill-icon shrink-0 relative">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 17s-6-3.5-6-8a3.5 3.5 0 0 1 6-2.45A3.5 3.5 0 0 1 16 9c0 4.5-6 8-6 8Z" stroke="currentColor" stroke-width="1.4"/>
        </svg>
        <span
          data-wishlist-count
          class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 inline-flex items-center justify-center rounded-full bg-accent text-bg text-[10px] font-medium leading-none"
          style="display:none"
        ></span>
      </a>
    </div>
  </div>

  <div
    id="site-menu"
    hidden
    class="page-max page-pad mt-3"
  >
    <nav aria-label="Main" class="rounded-3xl bg-surface border border-hairline p-5 sm:p-6">
      <a href="/" class="block w-full text-center rounded-full bg-ink text-bg py-3 font-serif text-[18px]">MalikFits</a>

      <p class="label mt-6 mb-3">Shop the fit</p>
      <ul class="grid gap-2">
        <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href="/outfits"><span>All looks</span><span aria-hidden="true">→</span></a></li>
        {styles.map(s => (
          <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href={`/outfits?style=${s.slug}`}><span>{s.label}</span><span aria-hidden="true">→</span></a></li>
        ))}
      </ul>

      <p class="label mt-6 mb-3">Catalog</p>
      <ul class="grid gap-2">
        <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href="/catalog"><span>All products</span><span aria-hidden="true">→</span></a></li>
        {categories.map(c => (
          <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href={`/catalog/${c.slug}`}><span>{c.label}</span><span aria-hidden="true">→</span></a></li>
        ))}
      </ul>

      <p class="label mt-6 mb-3">More</p>
      <ul class="grid gap-2">
        <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href="/about"><span>About Malik</span><span aria-hidden="true">→</span></a></li>
        <li><a class="flex items-center justify-between px-4 py-3 rounded-2xl bg-bg border border-hairline hover:border-ink/40 transition-colors" href="/wishlist"><span>Wishlist</span><span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('site-menu')!;
  btn.addEventListener('click', () => {
    const open = nav.hasAttribute('hidden') ? false : true;
    if (open) { nav.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
    else      { nav.removeAttribute('hidden');  btn.setAttribute('aria-expanded', 'true');  }
  });
</script>
