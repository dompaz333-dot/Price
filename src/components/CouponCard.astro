---
import type { Coupon } from '../lib/data';

interface Props { coupon: Coupon; compact?: boolean; }
const { coupon, compact = false } = Astro.props as Props;
const expiryShort = coupon.expires
  ? new Date(coupon.expires).toLocaleDateString('en-GB', { month: 'short', year: '2-digit' })
  : null;
const hasCode = Boolean(coupon.code);
---
<article class={`rounded-2xl bg-surface border border-hairline ${compact ? 'p-6' : 'p-7 sm:p-9'}`}>
  <div class="flex items-start gap-4">
    {coupon.logo && (
      <img
        src={coupon.logo}
        alt={`${coupon.retailer} logo`}
        width="56"
        height="56"
        loading="lazy"
        class={`${compact ? 'w-12 h-12' : 'w-14 h-14 sm:w-16 sm:h-16'} rounded-xl object-cover shrink-0 border border-hairline bg-bg`}
      />
    )}
    <div class="flex-1 min-w-0">
      <div class="flex items-baseline justify-between gap-3">
        <p class="label truncate">{coupon.retailer}</p>
        {expiryShort && <p class="label !text-ink-soft shrink-0">Until {expiryShort}</p>}
      </div>
      <h3 class={`mt-2 font-serif font-light text-ink leading-[1.05] tracking-[-0.02em] ${compact ? 'text-[24px] sm:text-[26px]' : 'text-[30px] sm:text-[40px]'}`}>{coupon.label}</h3>
    </div>
  </div>

  {!compact && (
    <p class="mt-4 max-w-md text-ink-muted text-[15px] leading-[1.55]">{coupon.description}</p>
  )}

  <div class={`${compact ? 'mt-5' : 'mt-7'} flex flex-col sm:flex-row gap-3 sm:items-stretch`}>
    {hasCode && (
      <div class="flex-1 flex items-center gap-3 px-5 h-12 rounded-full bg-bg border border-hairline">
        <span class="label shrink-0">Code</span>
        <code class="font-sans font-medium text-ink text-[13px] truncate" style="letter-spacing:0.06em" data-coupon-code>{coupon.code}</code>
        <button
          type="button"
          class="ml-auto shrink-0 inline-flex items-center gap-1.5 text-ink-muted hover:text-ink transition-colors"
          data-copy-code={coupon.code}
          aria-label={`Copy code ${coupon.code}`}
        >
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="8" height="8" rx="1.2" stroke="currentColor" stroke-width="1.3"/>
            <path d="M2.5 9.5V3a1 1 0 0 1 1-1H9" stroke="currentColor" stroke-width="1.3"/>
          </svg>
          <span data-copy-label class="font-sans uppercase text-[10.5px] font-medium" style="letter-spacing:0.18em">Copy</span>
        </button>
      </div>
    )}
    <a
      href={coupon.url}
      target="_blank"
      rel="noopener sponsored nofollow"
      class={`btn-primary ${hasCode ? '!w-full sm:!w-auto' : 'flex-1'}`}
    >
      {hasCode ? `Shop ${coupon.retailer}` : `Shop ${coupon.retailer} →`}
    </a>
  </div>
</article>
