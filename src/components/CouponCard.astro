---
import type { Coupon } from '../lib/data';

interface Props { coupon: Coupon; compact?: boolean; }
const { coupon, compact = false } = Astro.props as Props;
const expiryShort = coupon.expires
  ? new Date(coupon.expires).toLocaleDateString('en-GB', { month: 'short', year: '2-digit' })
  : null;
const hasCode = Boolean(coupon.code);
---
<article class={`rounded-2xl bg-surface border border-hairline overflow-hidden ${compact ? 'p-6' : 'p-7 sm:p-9'}`}>
  <div class="flex items-start gap-4 sm:gap-5">
    {coupon.logo && (
      <img
        src={coupon.logo}
        alt={`${coupon.retailer} logo`}
        width="72"
        height="72"
        loading="lazy"
        class={`${compact ? 'w-14 h-14' : 'w-16 h-16 sm:w-[72px] sm:h-[72px]'} rounded-2xl object-cover shrink-0 border border-hairline bg-bg`}
      />
    )}
    <div class="flex-1 min-w-0">
      <div class="flex items-baseline justify-between gap-3">
        <p class="label truncate">{coupon.retailer}</p>
        {expiryShort && <p class="label !text-ink-soft shrink-0">Until {expiryShort}</p>}
      </div>
      <h3 class={`mt-2 font-serif font-light text-ink leading-[1.02] tracking-[-0.02em] ${compact ? 'text-[26px] sm:text-[28px]' : 'text-[32px] sm:text-[44px]'}`}>{coupon.label}</h3>
    </div>
  </div>

  <p class={`${compact ? 'mt-5' : 'mt-6'} text-ink-muted text-[15px] leading-[1.6] max-w-xl`}>{coupon.description}</p>

  <div class={`${compact ? 'mt-6' : 'mt-8'} flex flex-col sm:flex-row gap-3 sm:items-stretch`}>
    {hasCode && (
      <div class="flex-1 flex items-center gap-3 px-5 h-14 rounded-full bg-bg border border-hairline">
        <span class="label shrink-0">Code</span>
        <code class="font-sans font-medium text-ink text-[14px] truncate" style="letter-spacing:0.06em" data-coupon-code>{coupon.code}</code>
        <button
          type="button"
          class="ml-auto shrink-0 inline-flex items-center gap-1.5 text-ink-muted hover:text-ink transition-colors"
          data-copy-code={coupon.code}
          aria-label={`Copy code ${coupon.code}`}
        >
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="8" height="8" rx="1.2" stroke="currentColor" stroke-width="1.3"/>
            <path d="M2.5 9.5V3a1 1 0 0 1 1-1H9" stroke="currentColor" stroke-width="1.3"/>
          </svg>
          <span data-copy-label class="font-sans uppercase text-[10.5px] font-medium" style="letter-spacing:0.18em">Copy</span>
        </button>
      </div>
    )}
    <a
      href={coupon.url}
      target="_blank"
      rel="noopener sponsored nofollow"
      class={`group relative inline-flex items-center justify-center gap-3 h-14 px-7 rounded-full bg-ink text-bg font-medium uppercase text-[12px] transition-all hover:opacity-95 hover:scale-[1.005] active:scale-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink ${hasCode ? 'sm:flex-1' : 'w-full'}`}
      style="letter-spacing:0.14em"
    >
      <span>Shop {coupon.retailer}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
        <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  {!hasCode && (
    <div class="mt-4 flex items-center gap-2 text-ink-soft">
      <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="shrink-0">
        <path d="M3 7.5 6 10.5l5-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="font-sans uppercase text-[10px] font-medium" style="letter-spacing:0.18em">Direct to retailer · no code needed</span>
    </div>
  )}
</article>
